{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/auth/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "hr-identity",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/identity/{everything}",
      "UpstreamHttpMethod": [ "Post", "Get", "Options" ]
    },
    {
      "DownstreamPathTemplate": "/api/employees/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "hr-employee",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/employees/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Options" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "ApiGatewayKey",
        "AllowedScopes": []
      }
    },
    {
      "DownstreamPathTemplate": "/api/payroll/{everything}",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "hr-payroll",
          "Port": 80
        }
      ],
      "UpstreamPathTemplate": "/payroll/{everything}",
      "UpstreamHttpMethod": [ "Get", "Post", "Put", "Delete", "Options" ],
      "AuthenticationOptions": {
        "AuthenticationProviderKey": "ApiGatewayKey",
        "AllowedScopes": []
      }
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:7164",
    "_Note": "Production environment configuration. Hosts are set to service container names and ports are set to internal HTTP standard port 80."
  }
}
