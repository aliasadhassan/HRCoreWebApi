{
  "Jwt": {
    "Key": "THIS_IS_SUPER_SECRET_KEY_123456789",
    "Issuer": "LearningCoreWebApi",
    "Audience": "LearningCoreWebApi",
    "ExpireMinutes": 20,
    "RefreshTokenExpireDays": 7
  },
  "AllowedHosts": "*",
  "EmailSettings": {
    "Host": "smtp.gmail.com", // SmtpServer ki jagah Host use karein jaisa EmailService mein tha
    "Port": 587,
    "From": "your-email@gmail.com", // Yeh username jaisa hona chahiye
    "Username": "your-email@gmail.com", // Apna Gmail address yahan likhein
    "Password": "your-gmail-app-password" // **** Yahan App Password ayega ****
  },
  "AuthSettings": {
    "ResetPasswordTokenLifespanHours": 2,
    "ResetPasswordUrl": "http://localhost:4200/reset-password" // Frontend ka exact URL yahan likhein
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=ALI-ASAD;Database=LearningCoreAuthDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
